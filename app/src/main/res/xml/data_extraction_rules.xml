<?xml version="1.0" encoding="utf-8"?>
<!-- 当前宿主在 Android 12 及以上使用此规则：云备份和设备迁移均排除诊断日志。
     cacheDir 中的导出文件属于缓存；修改日志子目录名时同步更新两个备份规则文件。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
        <exclude domain="external" path="logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
        <exclude domain="external" path="logs/" />
    </device-transfer>
</data-extraction-rules>
